{
  "name": "oh-my-aihub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "test": "vitest run",
    "test:welcome": "vitest run src/welcome/WelcomePage.test.tsx",
    "build": "tsc -b && vite build",
    "generate:api": "npm --prefix tools/openapi-types ci --no-audit --no-fund --fetch-timeout=60000 && npm --prefix tools/openapi-types run generate",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "vditor": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
