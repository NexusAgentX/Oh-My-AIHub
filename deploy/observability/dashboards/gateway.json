    {
      "id": 21,
      "type": "timeseries",
      "title": "响应体字节 p95",
      "description": "上游读取与写给客户端分别计数；usage 过滤与断连会造成差异。",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,direction) (rate(aihub_response_bytes_bucket{format=~\"$format\",model=~\"$model\",channel=~\"$channel\",stream=~\"$stream\"}[$__rate_interval])))",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "记账结果 / 秒",
      "description": "not_booked 包括免费、自用、拒绝与记账失败，不能直接当失败率。",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(aihub_accounting_total{format=~\"$format\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "观测丢失与失败 / 秒",
      "description": "实时流丢失不影响核心计数；记账故障需查站内核对。",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(__name__) (rate({__name__=~\"aihub_gateway_events_dropped_total|aihub_live_messages_dropped_total|aihub_live_read_failures_total|aihub_diagnostic_timings_dropped_total|aihub_diagnostic_timings_failed_total|aihub_metrics_refresh_failures_total|aihub_settlement_failures_total\"}[$__rate_interval]))",
          "legendFormat": "{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "定时刷新距今",
      "description": "正常约 60 秒内；零时间戳表示尚未成功刷新。",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-aihub_metrics_last_refresh_timestamp_seconds",
